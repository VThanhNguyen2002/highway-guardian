# Sử dụng 1 Stage duy nhất để tránh nhân bản Layer
FROM python:3.10-slim-bookworm

WORKDIR /app

# Cài đặt hệ thống và xóa rác ngay trong 1 dòng
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libgomp1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy requirements và cài đặt
COPY backend/requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    # XÓA CÁC FILE TEST VÀ FILE THỪA CỦA TORCH ĐỂ GIẢM DUNG LƯỢNG (QUAN TRỌNG)
    && find /usr/local/lib/python3.10/site-packages/torch -name "test" -type d -exec rm -rf {} + \
    && find /usr/local/lib/python3.10/site-packages/torch -name "bin" -type d -exec rm -rf {} +

# Copy code
COPY backend/ ./backend/
COPY src/core/ ./src/core/
COPY models/ ./models/
COPY docs/ ./docs/

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]