# ============================================================
# Highway Guardian — Root .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ── Environment & Secrets (NEVER commit) ────────────────────
.env
.env.*
*.env
frontend/.env
frontend/.env.*

# ── Firebase Keys (NEVER commit) ────────────────────────────
keys/
firebase_key.json
serviceAccountKey.json
*.key
*.pem

# ── AI Model Weights (too large for Git; download manually) ──
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.onnx
models/**/*.h5
models/**/*.weights
# Never ignore model config / architecture files
!models/*.py
!models/configs/
!models/**/.gitkeep

# ── Uploads (user-submitted images — never persist in Git) ───
uploads/*
!uploads/.gitkeep

# ── Local Databases ─────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.yarn/

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log
firestore-debug.log
ui-debug.log

# ── Testing & Coverage ──────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.tox/
.nox/

# ── Type checkers & linters ─────────────────────────────────
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/

# ── ML Training artefacts ───────────────────────────────────
runs/
**/runs/
wandb/
mlruns/
tensorboard_logs/
outputs/
.hydra/
ray_results/

# ── Data directories (raw datasets — use DVC/S3 instead) ────
data/raw/
data/processed/
data/external/
data/traffic_signs/extracted/
data/vehicles/extracted/

# ── Misc large files ────────────────────────────────────────
*.tar.gz
*.rar
*.zip
*.7z
*.pkl
*.pickle
*.hdf5

# ── OS generated ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ── IDE ─────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── Firebase hosting ────────────────────────────────────────
.firebase/

# ── Jupyter ─────────────────────────────────────────────────
.ipynb_checkpoints
.jupyter/

# ── Misc ────────────────────────────────────────────────────
*.bak
*.backup
*.tmp
*.temp
*.swp
*.swo
*~
Pipfile.lock
.cache/