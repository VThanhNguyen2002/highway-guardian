# ===========================================================================
# Highway Guardian — Environment Variable Template
# Copy to .env and fill in values before running docker compose.
# ===========================================================================

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (development, auto-created):
DATABASE_URL=sqlite+aiosqlite:///./highway_guardian.db

# PostgreSQL (production, uncomment and fill):
# DATABASE_URL=postgresql+asyncpg://pguser:pgpassword@postgres:5432/highway_guardian

# ── Model Paths (resolved by Docker volume mounts) ──────────────────────────
YOLO_MODEL_PATH=/app/models/yolo/yolov8.pt
CNN_MODEL_PATH=/app/models/cnn/best_mobilenet_v2.pth

# ── PDF Rule Document ────────────────────────────────────────────────────────
PDF_PATH=/app/docs/quy-chuan-ky-thuat-qcvn-41-2019-bgtvt-bao-hieu-duong-bo.pdf

# ── CORS & Service URLs ──────────────────────────────────────────────────────
# Backend URL consumed by Streamlit (internal Docker network)
BACKEND_URL=http://backend:8000

# Backend URL consumed by Vue frontend (browser → host)
VITE_API_BASE_URL=http://localhost:8000

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
CNN_NUM_CLASSES=103
MAX_UPLOAD_SIZE_MB=10       # Hard cap on upload size in MiB (default: 10)

# ── PostgreSQL (production only) ─────────────────────────────────────────────
POSTGRES_USER=pguser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=highway_guardian
