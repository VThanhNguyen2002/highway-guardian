cat << 'EOF' > .dockerignore
# 1. Bỏ qua mọi thứ theo mặc định (Chặn đứng copy lồng nhau)
*

# 2. CHỈ cho phép Docker nhìn thấy những file/thư mục này:
!backend/
!src/core/
!streamlit_app/
!frontend/
!docs/
!models/
!docker-compose.yml
!Dockerfile.backend
!Dockerfile.streamlit
!requirements.txt

# 3. Kể cả trong những thư mục được phép, cũng phải cấm các rác này:
**/__pycache__/
**/*.pyc
**/.env
**/venv/
**/env/
**/.git/
**/node_modules/
**/*.zip
**/*.mp4
**/notebooks/
**/results/
Projects/
EOF